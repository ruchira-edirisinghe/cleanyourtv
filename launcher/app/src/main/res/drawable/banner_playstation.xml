<?xml version="1.0" encoding="utf-8"?>
<!-- Banner for an input tile that opens a PlayStation (config.xml, input_tiles and app_banners): the white
     PlayStation mark on a deep blue field. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="320dp" android:height="180dp">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FF0070D1" android:endColor="#FF00246B" />
        </shape>
    </item>
    <item android:width="320dp" android:height="180dp">
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:gradientRadius="170dp" android:centerX="0.5" android:centerY="0.5"
                android:startColor="#3352A8FF" android:endColor="#00000000" />
        </shape>
    </item>
    <item android:width="96dp" android:height="74dp" android:gravity="center"
        android:drawable="@drawable/ic_playstation" />
</layer-list>
